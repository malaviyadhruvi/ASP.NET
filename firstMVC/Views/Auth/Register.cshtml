@firstMVC.Dto
@model UserDto
<form method="post" class="mx-auto p-4 border rounded shadow-sm" style="max-width: 400px;" asp-action="createUser">

    <h4 class="text-center mb-4">Register</h4>

    <div class="mb-3">
        <label class="form-label" name="Username" asp-for="Username">Username</label>
        <input type="text"
               name="Username"
               class="form-control"
               placeholder="Username"
               required />
    </div>

    <div class="mb-3">
        <label class="form-label" name="Email" asp-for="Email">Email</label>
        <input type="email"
               name="Email"
               class="form-control"
               placeholder="Email"
               required />
    </div>

    <div class="mb-3">
        <label class="form-label" name="Password" asp-for="Password">Password</label>
        <input type="password"
               name="Password"
               class="form-control"
               placeholder="Password"
               required />
    </div>

    <button type="submit" class="btn btn-primary w-100">
        Register
    </button>

</form>
Exixting User ? <a href="/Auth/Login">Click here to Login</a>