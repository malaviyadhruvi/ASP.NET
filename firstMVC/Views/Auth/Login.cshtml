<form method="post" class="mx-auto p-4 border rounded shadow-sm" style="max-width: 400px;">

    <h4 class="text-center mb-4">Login</h4>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email"
               name="Email"
               class="form-control"
               placeholder="Email"
               required />
    </div>

    <div class="mb-3">
        <label class="form-label">Password</label>
        <input type="password"
               name="Password"
               class="form-control"
               placeholder="Password"
               required />
    </div>

    <button type="submit" class="btn btn-primary w-100">
        Login
    </button>

</form>
New User ? <a href="/Auth/Register">Click here to register</a>