@using firstMVC.Dto
@model List<ProductDto>
<div class="container mt-4">

    <h2>Product Dashboard</h2>

    <a href="/Product/Create" class="btn btn-primary mb-3">
        Add Product
    </a>

    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Product Name</th>
                <th>Product Description</th>
                <th>Product Price</th>
                <th>Product Color</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @if(Model.Count > 0)
            {
                foreach(var product in Model)
                {
                    <tr>
                         <td>@product.Name</td>
                         <td>@product.Description</td>
                         <td>₹@product.Price</td>
                         <td>@product.Color</td>
                <td>
                    <a href="/Product/Edit/1" class="btn btn-warning">Edit</a>
                    <a href="/Product/Delete/1" class="btn btn-danger">Delete</a>
                </td>
            </tr>
                }
            }
            else
			{
				<tr>
					<td colspan="5" class="text-center">No products available.</td>
				</tr>
			}

        </tbody>

    </table>

</div>